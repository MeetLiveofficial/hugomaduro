default_platform(:ios)

BUNDLE_ID = ENV.fetch("APP_BUNDLE_ID", "com.krimson.app.528CZ6T823")
TEAM_ID_DEFAULT = "528CZ6T823"
CI_KEYCHAIN = "fastlane_tmp_keychain"

platform :ios do
  desc "Firma IPA App Store y lo sube a TestFlight"
  lane :release do
    key_id = ENV.fetch("APP_STORE_CONNECT_KEY_ID")
    issuer_id = ENV.fetch("APP_STORE_CONNECT_ISSUER_ID")
    key_content = ENV.fetch("APP_STORE_CONNECT_PRIVATE_KEY").gsub("\\n", "\n")
    team_id = ENV["APPLE_TEAM_ID"].to_s.strip
    team_id = TEAM_ID_DEFAULT if team_id.empty? || team_id == "WGTZ762S3W"
    key_is_base64 = !key_content.include?("BEGIN PRIVATE KEY")
    UI.message("Signing team: #{team_id} / bundle: #{BUNDLE_ID}")

    keychain_path = nil
    if is_ci
      create_keychain(
        name: CI_KEYCHAIN,
        password: CI_KEYCHAIN,
        default_keychain: true,
        unlock: true,
        timeout: 0,
        lock_when_sleeps: false,
        add_to_search_list: true
      )
      keychain_path = File.expand_path(
        lane_context[SharedValues::KEYCHAIN_PATH] ||
          "~/Library/Keychains/#{CI_KEYCHAIN}"
      )
      db_path = "#{keychain_path}-db"
      keychain_path = db_path if File.exist?(db_path)
      UI.message("CI keychain: #{keychain_path}")
    end

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: key_is_base64,
      in_house: false
    )

    certs_dir = File.expand_path("certificates", __dir__)
    FileUtils.mkdir_p(certs_dir)

    wwdr_path = File.join(certs_dir, "AppleWWDRCAG3.cer")
    sh("curl", "-fsSL", "-o", wwdr_path, "https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer")
    if is_ci
      import_certificate(
        certificate_path: wwdr_path,
        keychain_path: keychain_path,
        keychain_password: CI_KEYCHAIN
      )
    end

    p12_password = ENV.fetch("IOS_DIST_CERTIFICATE_PASSWORD", "")
    if ENV["IOS_DIST_CERTIFICATE_P12"].to_s.strip != ""
      require "base64"
      secret_p12 = File.join(certs_dir, "distribution.p12")
      File.binwrite(secret_p12, Base64.decode64(ENV["IOS_DIST_CERTIFICATE_P12"]))
      UI.message("Imported distribution .p12 from GitHub secret")
    end
    Dir[File.join(certs_dir, "*.p12")].each do |p12|
      next unless is_ci
      import_certificate(
        certificate_path: p12,
        certificate_password: p12_password,
        keychain_path: keychain_path,
        keychain_password: CI_KEYCHAIN
      )
    end

    cert_opts = {
      api_key: api_key,
      team_id: team_id,
      development: false,
      output_path: certs_dir,
      filename: "distribution"
    }
    if is_ci
      cert_opts[:keychain_path] = keychain_path
      cert_opts[:keychain_password] = CI_KEYCHAIN
    end
    get_certificates(**cert_opts)

    enable_app_id_capabilities(BUNDLE_ID)

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      team_id: team_id,
      provisioning_name: "Krimson App Store",
      filename: "Krimson_AppStore.mobileprovision",
      output_path: certs_dir,
      force: true
    )

    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    UI.user_error!("No se descargó el provisioning profile") if profile_path.to_s.empty?
    install_provisioning_profile(path: profile_path)
    assert_profile_has_entitlements(profile_path)

    profile_name = lane_context[SharedValues::SIGH_NAME]
    profile_uuid = lane_context[SharedValues::SIGH_UUID]
    UI.success("Provisioning profile: #{profile_name} (#{profile_uuid})")

    update_project_team(
      path: "Runner.xcodeproj",
      teamid: team_id
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      bundle_identifier: BUNDLE_ID,
      team_id: team_id,
      targets: ["Runner"],
      build_configurations: ["Release", "Profile"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      profile_uuid: profile_uuid
    )

    export_plist = File.expand_path("ExportOptions.plist", __dir__)
    File.write(
      export_plist,
      <<~XML
        <?xml version="1.0" encoding="UTF-8"?>
        <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
        <plist version="1.0">
        <dict>
          <key>method</key>
          <string>app-store-connect</string>
          <key>destination</key>
          <string>export</string>
          <key>teamID</key>
          <string>#{team_id}</string>
          <key>signingStyle</key>
          <string>manual</string>
          <key>signingCertificate</key>
          <string>Apple Distribution</string>
          <key>compileBitcode</key>
          <false/>
          <key>stripSwiftSymbols</key>
          <true/>
          <key>uploadSymbols</key>
          <true/>
          <key>manageAppVersionAndBuildNumber</key>
          <false/>
          <key>provisioningProfiles</key>
          <dict>
            <key>#{BUNDLE_ID}</key>
            <string>#{profile_name}</string>
          </dict>
        </dict>
        </plist>
      XML
    )

    repo_root = File.expand_path("../..", __dir__)
    if is_ci && keychain_path
      unlock_keychain(path: keychain_path, password: CI_KEYCHAIN)
      sh("security", "default-keychain", "-s", keychain_path)
      sh("security", "list-keychains", "-d", "user", "-s", keychain_path)
    end
    Dir.chdir(repo_root) do
      sh("mkdir", "-p", "build/ios/SourcePackages")
      sh(
        "flutter",
        "build",
        "ipa",
        "--release",
        "--export-options-plist=ios/fastlane/ExportOptions.plist"
      )
    end

    ipa = Dir[File.expand_path("../../build/ios/ipa/*.ipa", __dir__)].first
    UI.user_error!("No se encontró el IPA en build/ios/ipa") if ipa.nil?
    UI.success("IPA: #{ipa}")

    unless ENV["SKIP_UPLOAD"] == "true"
      upload_to_testflight(
        api_key: api_key,
        ipa: ipa,
        apple_id: ENV.fetch("APP_STORE_APPLE_ID", "6802754271"),
        skip_waiting_for_build_processing: true,
        distribute_external: false,
        changelog: "Meet&Live #{ENV.fetch('FLUTTER_BUILD_NAME', '')} (#{ENV.fetch('FLUTTER_BUILD_NUMBER', '')})"
      )
    end
  end
end

def enable_app_id_capabilities(bundle_identifier)
  require "spaceship"
  type = Spaceship::ConnectAPI::BundleIdCapability::Type
  settings_mod = Spaceship::ConnectAPI::BundleIdCapability::Settings
  options_mod = Spaceship::ConnectAPI::BundleIdCapability::Options

  bundle = Spaceship::ConnectAPI::BundleId.find(bundle_identifier)
  UI.user_error!("App ID #{bundle_identifier} no existe en App Store Connect / Developer Portal") unless bundle
  UI.success("App ID: #{bundle.name} (#{bundle.id})")

  apple_signin_settings = [{
    key: settings_mod::APPLE_ID_AUTH_APP_CONSENT,
    options: [{ key: options_mod::PRIMARY_APP_CONSENT }]
  }]
  desired = {
    type::PUSH_NOTIFICATIONS => [],
    type::ASSOCIATED_DOMAINS => [],
    type::APPLE_ID_AUTH => apple_signin_settings
  }

  desired.each do |cap, settings|
    begin
      bundle.update_capability(cap, enabled: true, settings: settings)
      UI.success("Enabled #{cap}")
    rescue StandardError => e
      begin
        bundle.create_capability(cap, settings: settings)
        UI.success("Created #{cap}")
      rescue StandardError => e2
        msg = "#{e.message} / #{e2.message}"
        if msg.downcase.include?("already") || msg.include?("409")
          UI.message("#{cap} already enabled")
        else
          UI.user_error!(
            "No se pudo activar #{cap} en #{bundle_identifier}: #{msg}. " \
            "Actívala a mano en https://developer.apple.com/account/resources/identifiers/list"
          )
        end
      end
    end
  end
end

def assert_profile_has_entitlements(profile_path)
  require "plist"
  xml = sh("security", "cms", "-D", "-i", profile_path, log: false)
  entitlements = (Plist.parse_xml(xml) || {})["Entitlements"] || {}
  UI.message("Profile entitlements: #{entitlements.keys.join(', ')}")
  required = [
    "aps-environment",
    "com.apple.developer.applesignin",
    "com.apple.developer.associated-domains"
  ]
  missing = required.reject { |key| entitlements.key?(key) }
  return if missing.empty?

  UI.user_error!(
    "El perfil no incluye #{missing.join(', ')}. " \
    "En https://developer.apple.com/account/resources/identifiers/list abre " \
    "#{BUNDLE_ID} y activa Push Notifications, Associated Domains y Sign In with Apple. " \
    "Luego relanza el workflow."
  )
end
